{
  "name": "@light-cat/pi-auto-name",
  "version": "0.1.3",
  "description": "Name a pi session when it ends, from what the session actually did.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "session",
    "name",
    "title"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "author": "EvilIrving <dong.yy1916@gmail.com>",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilirving/pi-auto-name.git"
  },
  "bugs": {
    "url": "https://github.com/evilirving/pi-auto-name/issues"
  },
  "homepage": "https://github.com/evilirving/pi-auto-name#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "prepack": "npm test && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.3"
  }
}
